# Copy this file to .env and adjust as needed. All values shown are the
# built-in defaults sandboxd falls back to when a variable is unset.

# HTTP server
PORT=:8089
READ_TIMEOUT=30
WRITE_TIMEOUT=120
IDLE_TIMEOUT=60

# Auth — if unset, POST /run is unauthenticated. Set this in any environment
# reachable outside your own machine.
# API_KEY=

# Logging
LOG_LEVEL=info
LOG_JSON=true

# Language / nsjail
LANG_CONFIG=config/lang.yaml
NSJAIL_PATH=/usr/sbin/nsjail
NSJAIL_BASE_DIR=/tmp/sandboxd-jails
MAX_CONCURRENT=100
ORPHAN_PROC_TIME=10

# Request limits
MAX_SOURCE_SIZE=262144
MAX_TEST_SIZE=50
MAX_STDIN=65536
MAX_FILENAME_CHAR=65
MAX_OUTPUT_SIZE=4194304
TRUNC_OUTPUT=\n[output truncated]
